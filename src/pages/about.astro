---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Link from '@/components/Link.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import { SITE } from '@/consts'

// Person Schema for About page
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": SITE.title,
  "url": SITE.href,
  "description": SITE.description
}
---
<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  
  <!-- Person Schema for About page SEO -->
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:user' }]} />

  <section class="flex flex-col gap-8">
    <!-- Header -->
    <div class="flex flex-col gap-4">
      <div>
        <h1 class="text-3xl md:text-4xl font-bold">About Me</h1>
        <p class="text-sm text-muted-foreground font-mono mt-1">
          Security engineer & builder
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="prose prose-sm dark:prose-invert max-w-none space-y-6">
      <p class="text-muted-foreground leading-relaxed">
        I'm <strong class="text-primary">Ella Park</strong>, a security engineer bridging enterprise defense and AI security. Based in San Francisco, I combine an attacker's mindset with reproducible defense strategies to protect organizations and their systems.
      </p>

      <h3>What I Do</h3>
      <p class="text-muted-foreground leading-relaxed">
        My focus spans three key areas: defending enterprise infrastructure through WAF detection and incident response, modeling threats across complex deployments, and red-teaming LLM systems to harden them against adversarial attacks. I've defended 50+ clients from crypto exchanges to e-commerce platforms, and consistently deliver measurable outcomes—whether containing threats under ≥99.9% uptime or driving down attack success rates while keeping false positives under 5%.
      </p>

      <h3>Background & Education</h3>
      <ul class="space-y-2 text-muted-foreground leading-relaxed">
        <li><strong>MS, Information Security</strong> — Carnegie Mellon University (Aug 2026 – Dec 2027)</li>
        <li><strong>BEng, Information Security</strong> — Seoul Women's University (Mar 2020 – Feb 2025)</li>
      </ul>

      <h3>Technical Skills</h3>
      <ul class="space-y-1 text-sm text-muted-foreground">
        <li><strong>Cloud & Security:</strong> AWS (IAM, WAF, Lambda, Bedrock), Terraform, Ansible, GitHub Actions</li>
        <li><strong>Detection & Response:</strong> MITRE ATT&CK, behavioral anomaly detection, incident response</li>
        <li><strong>AI Security:</strong> Prompt injection & jailbreak testing (garak), guardrail design, OWASP LLM Top 10</li>
        <li><strong>Languages:</strong> Python, Java, JavaScript/TypeScript, React, Next.js, MySQL, Docker</li>
      </ul>

      <h3>Notable Projects</h3>
      <ul class="space-y-3 text-muted-foreground">
        <li>
          <strong>ThreatSight</strong> — Detection-as-Code pipeline with CI quality gates, behavioral anomaly detection, and automated threat coverage mapping
        </li>
        <li>
          <strong>CortexWAF</strong> — Multi-agent WAF automation system (Top Prize, AWS × Megazone Hackathon 2026) with closed-loop detection and response
        </li>
      </ul>

      <h3>Contact</h3>
      <p class="text-muted-foreground leading-relaxed">
        Interested in security, AI, or infrastructure? Feel free to reach out:
      </p>
      <ul class="space-y-1 text-sm">
        <li><strong>Email:</strong> <Link href="mailto:ellapark@andrew.cmu.edu">ellapark@andrew.cmu.edu</Link></li>
        <li><strong>LinkedIn:</strong> <Link href="https://linkedin.com/in/ellasypark">linkedin.com/in/ellasypark</Link></li>
        <li><strong>GitHub:</strong> <Link href="https://github.com/ellasypark">github.com/ellasypark</Link></li>
      </ul>
    </div>
  </section>
</Layout>
